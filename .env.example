# Copy this file to `.env.local` and fill in the values.
# On Vercel, add the same variables under Project Settings → Environment Variables.

# Web3Forms access key (browser-safe, hence NEXT_PUBLIC_). https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# Neon Postgres connection string (server-only — never NEXT_PUBLIC). https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Resend API key for sending email (server-only). https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# From address — must be on a Resend-verified domain.
EMAIL_FROM=CNX247 <noreply@cnx247.com>

# Admin dashboard login (HTTP Basic Auth) — protects /admin. Use a strong password.
ADMIN_USER=admin
ADMIN_PASSWORD=set-a-strong-password

# Protects the /api/cron/reminder endpoint (Vercel Cron sends it as a Bearer token).
CRON_SECRET=set-a-long-random-string

# Optional: teaser video link shown in the 24-hour reminder email.
# TEASER_VIDEO_URL=https://...
